{
  "name": "liteexplorer",
  "version": "0.1.28",
  "description": "",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun run gen:changelog && vite dev",
    "build": "bun run gen:changelog && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "gen:changelog": "bun scripts/gen-changelog.ts",
    "changelog": "bun scripts/changelog.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:ts": "bun test --path-ignore-patterns \"**/controller.test.ts\" && vitest run src/lib/file-pane/controller.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:ts": "oxlint src",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "bun run test:ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@shikijs/langs": "4.4.3",
    "@shikijs/monaco": "4.4.3",
    "@tanstack/svelte-virtual": "^3.13.38",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "dompurify": "^3.4.15",
    "fuse.js": "^7.5.0",
    "marked": "^18.0.13",
    "monaco-editor": "0.56.0",
    "pdfjs-dist": "^6.3.289",
    "shiki": "4.4.3",
    "temporal-polyfill": "^1.0.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.45.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.186.0",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "layerchart": "^2.0.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.1.0",
    "sveltekit-superforms": "^2.30.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
