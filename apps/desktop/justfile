# Updater signing key for release builds, in the repo's keys folder (ignored by git). Keep it
# private and copy it to every machine that builds releases.
export TAURI_SIGNING_PRIVATE_KEY := env_var_or_default("TAURI_SIGNING_PRIVATE_KEY", justfile_directory() / ".." / ".." / "keys" / "liteexplorer.key")
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD := env_var_or_default("TAURI_SIGNING_PRIVATE_KEY_PASSWORD", "")

# On Windows just defaults to `sh`, which is often missing. Use cmd.exe instead.
set windows-shell := ["cmd.exe", "/C"]

# Show available commands.
default:
    @just --list

# Set the app version in tauri.conf.json, package.json and Cargo.toml, like `just bump 0.2.0`.
bump version:
    bun scripts/bump-version.ts {{version}}
    cargo update --workspace --manifest-path src-tauri/Cargo.toml --offline

# Install JavaScript dependencies.
i:
    bun install

# Run the Tauri app in development mode.
[unix]
dev:
    bun i && bun run tauri dev

# Run the Tauri app in development mode.
[windows]
dev:
    bun i && bun run tauri dev

# Create a production Tauri build.
build:
    bun run tauri build

# Build a macOS .dmg installer (output: src-tauri/target/release/bundle/dmg).
[macos]
build-dmg:
    bun i && bun run tauri build --bundles dmg
    @ls -1 src-tauri/target/release/bundle/dmg/*.dmg

# Run on a Mac. Output: src-tauri/target/universal-apple-darwin/release/bundle/{macos,dmg}.
# Release build for macOS: universal .app and .dmg (Apple Silicon and Intel).
[macos]
release-mac:
    bun install --frozen-lockfile
    rustup target add aarch64-apple-darwin x86_64-apple-darwin
    bun run tauri build --target universal-apple-darwin --bundles app,dmg
    @ls -1 src-tauri/target/universal-apple-darwin/release/bundle/dmg/*.dmg

# Run on Linux with libwebkit2gtk-4.1-dev, libayatana-appindicator3-dev, librsvg2-dev, patchelf.
# Output: src-tauri/target/release/bundle/{deb,rpm,appimage}.
# Release build for Linux: .deb, .rpm and .AppImage.
[linux]
release-linux:
    bun install --frozen-lockfile
    bun run tauri build --bundles deb,rpm,appimage
    @ls -1 src-tauri/target/release/bundle/deb/*.deb src-tauri/target/release/bundle/rpm/*.rpm src-tauri/target/release/bundle/appimage/*.AppImage

# Run on Windows from Git Bash with the MSVC build tools installed.
# Installs for the current user without admin rights. Output: src-tauri/target/release/bundle/nsis.
# Release build for Windows: .exe setup (NSIS).
[windows]
release-windows:
    bun install --frozen-lockfile
    bun run tauri build --bundles nsis
    @dir /b src-tauri\target\release\bundle\nsis\*.exe

# Format JavaScript, Svelte, JSON, TOML, and Rust sources.
fmt:
    bunx oxfmt . '!**/.agents/**' '!**/.claude/**' '!**/.crush/**' '!**/.pi/**'
    cargo fmt --manifest-path src-tauri/Cargo.toml

# Lint JavaScript and TypeScript sources.
lint:
    bunx oxlint src

# Remove generated dependencies and build artifacts.
[unix]
clean:
    rm -rf node_modules build .svelte-kit package src-tauri/target src-tauri/gen/schemas

# Remove generated dependencies and build artifacts (Windows).
[windows]
clean:
    if exist node_modules rmdir /s /q node_modules
    if exist build rmdir /s /q build
    if exist .svelte-kit rmdir /s /q .svelte-kit
    if exist package rmdir /s /q package
    if exist src-tauri\target rmdir /s /q src-tauri\target
    if exist src-tauri\gen\schemas rmdir /s /q src-tauri\gen\schemas
