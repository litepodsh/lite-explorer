# Copy to `.env` and fill in. Optional: without a DSN, crash reporting is disabled.
SENTRY_DSN=
# Google OAuth Desktop Client ID. This is public configuration, not a client secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Aptabase usage analytics. Optional: without an app key, usage analytics are disabled.
# A self-hosted key (A-SH-...) also needs the server URL, e.g. https://aptabase.example.com
APTABASE_APP_KEY=
APTABASE_HOST=
