---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Lite Explorer — Less chrome. More room for your files.',
	description = 'A calm, native-feeling file explorer for macOS, Linux, and Windows. Tabs, split panes, and full keyboard control, built with Tauri and SvelteKit.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(() => {
				try {
					document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
				} catch {
					document.documentElement.dataset.theme = 'dark';
				}

				// Drives the platform-specific window chrome (see WindowFrame.astro).
				// `?os=macos|windows|linux|ios` forces a specific chrome (debug).
				const ua = navigator.userAgent;
				const touch = (navigator.maxTouchPoints || 0) > 1;
				const isIOS = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && touch);

				let os = 'macos';
				if (/Windows/i.test(ua)) {
					os = 'windows';
				} else if (/Linux|X11/i.test(ua) && !/Android/i.test(ua)) {
					os = 'linux';
				} else if (isIOS) {
					os = 'macos';
				}

				const override = new URLSearchParams(location.search).get('os');
				if (override === 'macos' || override === 'windows' || override === 'linux') {
					os = override;
				} else if (override === 'ios') {
					os = 'macos';
				}

				document.documentElement.dataset.platform = os;
			})();
		</script>

		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" content="#242220" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/lite-explorer-preview.png" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/app-icon.png" />

		<script
			is:inline
			defer
			src="https://umami.sebasgc.xyz/script.js"
			data-website-id="90abd353-1750-4526-b898-e4c1c3bfa752"
			data-performance="true"
		></script>
		<script
			is:inline
			defer
			src="https://umami.sebasgc.xyz/recorder.js"
			data-website-id="90abd353-1750-4526-b898-e4c1c3bfa752"
		></script>
	</head>
	<body>
		<slot />
	</body>
</html>
