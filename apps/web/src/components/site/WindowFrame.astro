---
interface Props {
	title: string;
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

const { src, alt, width, height } = Astro.props;
---

<!-- The screenshots already include the app's own window chrome, so no fake title bar here. -->
<figure
	class="m-0 overflow-hidden rounded-[14px] bg-surface shadow-[0_0_0_1px_rgb(255_255_255/0.08),inset_0_1px_0_rgb(255_255_255/0.06),0_40px_90px_-30px_rgb(0_0_0/0.8),0_10px_30px_-14px_rgb(0_0_0/0.6)] transition-transform duration-700 ease-out"
>
	<img src={src} width={width} height={height} alt={alt} class="block w-full" />
</figure>
