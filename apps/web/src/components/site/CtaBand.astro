---
import { site } from '../../lib/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section class="shell py-[clamp(48px,7vw,88px)]">
	<div
		class="reveal flex flex-wrap items-center justify-between gap-7 rounded-2xl border border-border bg-sidebar bg-[radial-gradient(120%_160%_at_100%_0%,color-mix(in_oklab,var(--accent)_10%,transparent),transparent_55%)] p-[clamp(32px,5vw,56px)]"
	>
		<div class="max-w-[46ch]">
			<h2 class="text-[clamp(1.9rem,3.4vw,2.9rem)]">Try it on your desktop.</h2>
			<p class="mt-3 text-[15px] leading-[1.6] text-muted">
				Download for {site.platforms.slice(0, -1).join(', ')}, or {site.platforms.at(-1)}, and make
				it yours. It is open source and built in the open.
			</p>
		</div>
		<div class="flex flex-wrap gap-3">
			<Button href={site.download} target="_blank" rel="noreferrer">
				<Icon name="download" size={17} />
				Download for macOS
			</Button>
			<Button href={site.repo} variant="ghost" target="_blank" rel="noreferrer">
				<Icon name="github" size={16} />
				View repository
			</Button>
		</div>
	</div>
</section>
