---
import { hostLink, site } from '../../lib/content';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import WindowFrame from './WindowFrame.astro';
---

<section class="shell grid items-center gap-[clamp(32px,5vw,64px)] pt-[clamp(56px,8vw,108px)] pb-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1.1fr)]">
	<div>
		<Eyebrow dot class="reveal mb-[22px]" style="--reveal-delay: 40ms">
			Tauri 2 · SvelteKit · Cross-platform
		</Eyebrow>

		<h1 class="reveal text-[clamp(2.6rem,5.4vw,4.15rem)] tracking-[-0.035em]" style="--reveal-delay: 90ms">
			Less chrome.<br />More room for your files.
		</h1>

		<p class="reveal mt-[22px] max-w-[52ch] text-[clamp(15px,1.4vw,17px)] leading-[1.65] text-muted" style="--reveal-delay: 150ms">
			A calm, native-feeling file explorer for macOS, Linux, and Windows. Tabs and split panes,
			live content search, and every action one keystroke away — without the clutter of a legacy
			file manager.
		</p>

		<div class="reveal mt-[30px] flex flex-wrap gap-3" style="--reveal-delay: 210ms">
			<Button href={site.download} target="_blank" rel="noreferrer">
				<Icon name="download" size={17} />
				Download
			</Button>
			<Button href={site.repo} variant="ghost" target="_blank" rel="noreferrer">
				View repository
				<Icon name="arrow-up-right" size={15} />
			</Button>
		</div>

		<div class="reveal mt-[22px] flex flex-wrap items-center gap-2 text-[12.5px] text-muted-dim" style="--reveal-delay: 260ms">
			<span class="flex flex-wrap items-center gap-1.5">
				{
					site.platforms.map((platform) => (
						<span class="rounded-full border border-border px-2 py-0.5 font-medium text-muted">
							{platform}
						</span>
					))
				}
			</span>
			<span class="text-muted-faint">·</span>
			<span>{site.version}</span>
			<span class="text-muted-faint">·</span>
			<span>Free &amp; open source</span>
			<span class="text-muted-faint">·</span>
			<a
				class="ease-glass inline-flex items-center gap-1.5 rounded-full border border-border px-2 py-0.5 font-medium text-muted transition-colors duration-200 hover:text-foreground"
				href={hostLink}
				target="_blank"
				rel="noreferrer"
				data-umami-event="litepod-referral"
				data-umami-event-source="hero"
				data-umami-event-destination="litepod.sh"
			>
				<span class="animate-litepod-ring grid size-[13px] shrink-0 place-items-center rounded-full motion-reduce:animate-none">
					<img src={site.host.logo} alt="" width="12" height="12" />
				</span>
				{site.host.tagline}
			</a>
		</div>
	</div>

	<div class="reveal relative" style="--reveal-delay: 200ms">
		<WindowFrame
			title={site.name}
			src="/preview-overview.png"
			width={2638}
			height={1670}
			alt="The Lite Explorer Overview screen, showing disk capacity, volumes, and what is using space in the home folder"
		/>

		<div class="absolute -right-1.5 -bottom-[18px] inline-flex items-center gap-2.5 rounded-full bg-surface/90 px-3.5 py-2.5 font-mono text-[11.5px] text-foreground-soft shadow-[inset_0_1px_0_rgb(255_255_255/0.09),inset_0_0_0_1px_rgb(255_255_255/0.06),0_6px_16px_-8px_rgb(0_0_0/0.4)] backdrop-blur-[18px] backdrop-saturate-150" aria-hidden="true">
			<span class="size-2 rounded-full bg-accent animate-pulse-ring"></span>
			<span>⇧⌘P · Command palette</span>
		</div>
	</div>
</section>
