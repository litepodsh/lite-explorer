---
import { hostLink, site } from '../../lib/content';
import Icon from '../ui/Icon.astro';

const links = [
	{ href: site.repo, label: 'Repository' },
	{ href: `${site.repo}#install-on-macos`, label: 'Install' },
	{ href: site.releases, label: 'Releases' },
	{ href: site.licenseUrl, label: 'License' },
];
---

<footer class="mt-6 border-t border-border">
	<div class="shell flex flex-wrap items-center gap-4 py-7 pb-12 text-[13px] text-muted-dim">
		<div class="flex items-center gap-2.5 font-semibold text-foreground-soft">
			<img src="/logo.svg" alt="" width="18" height="18" />
			<span>{site.name}</span>
		</div>
		<p class="font-mono text-xs">{site.stack}</p>
		<p class="font-mono text-xs">{site.license}</p>
		<a
			class="ease-glass group inline-flex items-center gap-2 rounded-full border border-border bg-[var(--overlay-1)] px-3 py-1.5 font-mono text-xs text-muted transition-colors duration-200 hover:text-foreground"
			href={hostLink}
			target="_blank"
			rel="noreferrer"
			data-umami-event="litepod-referral"
			data-umami-event-source="footer"
			data-umami-event-destination="litepod.sh"
		>
			<span class="animate-litepod-ring grid size-[15px] shrink-0 place-items-center rounded-full motion-reduce:animate-none">
				<img src={site.host.logo} alt="" width="14" height="14" />
			</span>
			<span>
				{site.host.tagline}
				<span class="text-muted-dim group-hover:text-foreground"> {site.host.domain}</span>
			</span>
			<Icon name="arrow-up-right" size={12} />
		</a>
		<nav class="ml-auto flex gap-5" aria-label="Links">
			{
				links.map((link) => (
					<a
						class="ease-glass transition-colors duration-200 hover:text-foreground"
						href={link.href}
						target="_blank"
						rel="noreferrer"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
