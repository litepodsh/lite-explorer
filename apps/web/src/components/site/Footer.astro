---
import { site } from '../../lib/content';

const links = [
	{ href: site.repo, label: 'Repository' },
	{ href: `${site.repo}#install-on-macos`, label: 'Install' },
	{ href: site.releases, label: 'Releases' },
	{ href: site.licenseUrl, label: 'License' },
];
---

<footer class="mt-6 border-t border-border">
	<div class="shell flex flex-wrap items-center gap-4 py-7 pb-12 text-[13px] text-muted-dim">
		<div class="flex items-center gap-2.5 font-semibold text-foreground-soft">
			<img src="/logo.svg" alt="" width="18" height="18" />
			<span>{site.name}</span>
		</div>
		<p class="font-mono text-xs">{site.stack}</p>
		<p class="font-mono text-xs">{site.license}</p>
		<nav class="ml-auto flex gap-5" aria-label="Links">
			{
				links.map((link) => (
					<a
						class="ease-glass transition-colors duration-200 hover:text-foreground"
						href={link.href}
						target="_blank"
						rel="noreferrer"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
