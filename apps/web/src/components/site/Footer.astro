---
import { legal, site } from '../../lib/content';
---

<footer class="mt-8 border-t border-border">
	<div class="flex flex-wrap items-center gap-x-5 gap-y-2 px-4 py-6 text-[13px] text-muted-dim sm:px-6">
		<div class="flex items-center gap-2 font-semibold text-foreground-soft">
			<img src="/logo.svg" alt="" width="18" height="18" />
			<span>{site.name}</span>
		</div>
		<p class="font-mono text-xs">© {new Date().getFullYear()} {legal.publisher}</p>
		<p class="font-mono text-xs">{site.stack}</p>
		<p class="font-mono text-xs">{site.license}</p>
		<nav class="ml-auto flex flex-wrap gap-5" aria-label="Footer">
			<a class="ease-glass transition-colors duration-200 hover:text-foreground" href={site.repo} target="_blank" rel="noreferrer">GitHub</a>
			<a class="ease-glass transition-colors duration-200 hover:text-foreground" href={site.releases} target="_blank" rel="noreferrer">Releases</a>
			<a class="ease-glass transition-colors duration-200 hover:text-foreground" href="/llms.txt">llms.txt</a>
			<a class="ease-glass transition-colors duration-200 hover:text-foreground" href={legal.privacyPath}>Privacy</a>
			<a class="ease-glass transition-colors duration-200 hover:text-foreground" href={legal.termsPath}>Terms</a>
		</nav>
	</div>
</footer>
