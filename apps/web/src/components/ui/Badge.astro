---
import { cn } from '../../lib/utils';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span
	class={cn(
		'well inline-flex items-center rounded-full px-2.5 py-1 font-mono text-[11px] font-medium tracking-[0.08em] text-muted uppercase',
		className,
	)}
>
	<slot />
</span>
