---
import { cn } from '../../lib/utils';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<kbd
	class={cn(
		'grid h-7 min-w-7 place-items-center rounded-[7px] bg-surface-raised px-2 text-[12.5px] font-semibold text-foreground shadow-[var(--shadow-key)]',
		className,
	)}
>
	<slot />
