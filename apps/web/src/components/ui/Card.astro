---
import { cn } from '../../lib/utils';

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<article
	class={cn(
		'card-surface ease-glass flex flex-col rounded-lg border border-border p-6 transition-colors duration-200 hover:border-border-strong',
		className,
	)}
	{...rest}
>
	<slot />
</article>
