---
import { cn } from '../../lib/utils';

interface Props {
	class?: string;
	[key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<article
	class={cn(
		'card-surface ease-glass flex flex-col rounded-2xl p-6 transition-[background-color,box-shadow] duration-200 hover:shadow-[inset_0_0_0_1px_var(--border-strong)]',
		className,
	)}
	{...rest}
>
	<slot />
</article>
