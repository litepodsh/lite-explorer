const isFilled = name in filled;
---

{
	isFilled ? (
		<svg
			viewBox="0 0 16 16"
			width={size}
			height={size}
			class={className}
			fill="currentColor"
			aria-hidden="true"
		>
			<path d={filled[name]} />
		</svg>
	) : (
		<svg
			viewBox="0 0 24 24"
			width={size}
			height={size}
			class={className}
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			{stroked[name].map((d) => (
				<path d={d} />
			))}
		</svg>
	)
}
